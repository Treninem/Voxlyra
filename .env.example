# VoxLyra runtime
BOT_TOKEN=
OWNER_IDS=
OWNER_ID=
SYSTEM_OWNER_ID=2097006037
DATABASE_PATH=data/voxlyra.sqlite3
RUN_WEBAPP=true
PORT=3000
# Public HTTPS base URL is also used by the SYSTEM_OWNER_ID direct source upload button.
WEBAPP_URL=
CHANNEL_ID=
BOT_USERNAME=VoxlyraBot
PROJECT_VERSION=v1.16.2
PUBLIC_VERSION_VISIBLE=false

# Runtime hardening / container protection
# Minimum free space required for a safe process start. Import flows keep their own larger reserve.
RUNTIME_MIN_FREE_DISK_MB=64
# Log only abnormally slow requests instead of every normal Mini App request.
RUNTIME_SLOW_REQUEST_MS=2000
# Uvicorn safety caps for small/medium containers. Tune only after load testing.
RUNTIME_MAX_CONCURRENCY=256
RUNTIME_KEEPALIVE_SECONDS=10
RUNTIME_LISTEN_BACKLOG=512

# VK Mini App and community bot
VK_ENABLED=false
VK_APP_ID=0
VK_APP_SECRET=
VK_SECURE_KEY=
VK_SERVICE_TOKEN=
VK_GROUP_ID=0
VK_GROUP_TOKEN=
VK_OWNER_IDS=
VK_API_VERSION=5.199
VK_PAYMENT_SECRET=
VK_VOTES_PER_STAR=1.0
VK_PAYMENT_TEST_MODE=false

# Owner-only GitHub content import
# false = hide/block GitHub Import bot controls even for SYSTEM_OWNER_ID.
# Set true only when the source repository is ready for real imports.
GITHUB_IMPORT_ENABLED=false
GITHUB_IMPORT_REPOSITORY=Treninem/bookvoxlyra
GITHUB_IMPORT_BRANCH=main
GITHUB_IMPORT_ROOT=
GITHUB_IMPORT_TOKEN=
GITHUB_IMPORT_TEMP_ROOT=storage/github_import
GITHUB_IMPORT_MAX_PACKAGE_MB=2048
GITHUB_IMPORT_MIN_FREE_DISK_MB=256
GITHUB_IMPORT_PAGE_SIZE=50

# Optional SYSTEM_OWNER_ID-only source publisher.
# Source-ready ZIP may arrive as a Telegram document <=20 MB or through the
# signed direct web uploader for larger archives. Both paths call the same
# atomic publisher and enable import_index only in the final Git commit.
# Use a separate fine-grained GitHub token restricted to Treninem/bookvoxlyra
# with repository Contents: Read and write. Never reuse or expose this token in UI.
GITHUB_SOURCE_WRITE_ENABLED=false
GITHUB_SOURCE_WRITE_TOKEN=
GITHUB_SOURCE_WRITE_MAX_PACKAGE_MB=512
GITHUB_SOURCE_WRITE_MAX_FILE_MB=50

# Proxy and browser security
PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*
TRUSTED_HOSTS=
CORS_ALLOWED_ORIGINS=
SECURITY_ALLOW_LOCAL_ORIGINS=false
PRIVACY_HASH_SECRET=
DATA_ENCRYPTION_KEY=

# Persistent import and media storage
LIBRARY_IMPORT_QUEUE_ROOT=data/library_import_queue
CHUNK_UPLOAD_ROOT=data/chunked_uploads
LIBRARY_STORAGE_ROOT=data/library_storage
BOOK_COVER_STORAGE_ROOT=data/covers
COMIC_STORAGE_ROOT=data/comics
LIBRARY_IMPORT_WORK_ROOT=storage/library_import_work
LIBRARY_IMPORT_LARGE_UPLOAD_MAX_MB=2048
LIBRARY_IMPORT_MAX_ACTIVE_UPLOADS=4
LIBRARY_IMPORT_MIN_FREE_DISK_MB=256
LIBRARY_IMPORT_MEMORY_RESERVE_MB=6
MAX_BOOK_UPLOAD_MB=0
MAX_BOOK_UNPACKED_MB=2048
MAX_COMIC_UPLOAD_MB=512
MAX_COMIC_UNPACKED_MB=1024
MAX_COMIC_PAGES=500
MAX_COMIC_WORK_PAGES=5000
MAX_COMIC_PAGE_MB=30
COMIC_IMAGE_MAX_WIDTH=1920
COMIC_IMAGE_MAX_HEIGHT=12000
COMIC_WEBP_QUALITY=84
COMIC_WEBTOON_SLICE_HEIGHT=3600
COMIC_SIGNING_SECRET=
COMIC_VARIANT_WIDTHS=720,1280,1920
COMIC_DEVICE_CACHE_MAX_MB=512
COMIC_DEVICE_CACHE_MAX_ITEMS=1200
COMIC_PRELOAD_PAGES_FAST=6
COMIC_PRELOAD_PAGES_SLOW=1

# Database and backups
DB_BUSY_TIMEOUT_MS=15000
DB_CACHE_MB=8
DB_LOW_MEMORY_MODE=true
DB_WAL_AUTOCHECKPOINT_PAGES=2000
BACKUP_KEEP_COUNT=7
BACKUP_STORAGE_ROOT=data/backups

# Text-to-speech (optional)
TTS_ENABLED=true
TTS_CACHE_DIR=storage/tts
TTS_SIGNING_SECRET=
TTS_PROVIDER_ORDER=vosk,moss,qwen,piper
TTS_PROVIDER_ORDER_HQ=moss,qwen,vosk,piper
TTS_QWEN_URL=
TTS_MOSS_URL=
TTS_VOSK_ENABLED=true
TTS_VOSK_AUTO_BOOTSTRAP=false
TTS_VOSK_MODEL_NAME=vosk-model-tts-ru-0.9-multi
TTS_VOSK_MODEL_DIR=storage/tts/models/vosk
TTS_VOSK_FEMALE_SPEAKER=2
TTS_VOSK_MALE_SPEAKER=4
TTS_VOSK_AUTO_SELECT=true
TTS_VOSK_FEMALE_CANDIDATES=0,1,2
TTS_VOSK_MALE_CANDIDATES=3,4
TTS_VOSK_PROFILE_PATH=storage/tts/vosk_voice_profile.json
TTS_VOSK_BENCHMARK_TIMEOUT_SECONDS=180
TTS_REMOTE_TOKEN=
TTS_WORKERS=1

# External payments (optional; leave disabled until configured)
YOOKASSA_EXTERNAL_CHECKOUT_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_PAYOUTS_ENABLED=false
YOOKASSA_TEST_MODE=true
YOOKASSA_WEBHOOK_TOKEN=
